			"scatter_chance": { "numerator": 1, "denominator": 200 },
			"x": { "distribution": "uniform", "extent": [0, 15] },
			"y": "q.heightmap(v.worldx, v.worldz) - 3",
			"z": { "distribution": "uniform", "extent": [0, 15] }
		}
	}
