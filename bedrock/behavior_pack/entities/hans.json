					"priority": 1,
					"must_see": true,
					"entity_types": [
						{
							"filters": {
								"test": "is_family",
								"subject": "other",
								"value": "player"
							},
							"max_dist": 24
						}
					]
				},
				"minecraft:behavior.hurt_by_target": {
					"priority": 1
				}
			}
