				"add": {
					"component_groups": [
						"frozen:hostile"
					]
				}
			}
		},
		"component_groups": {
			"frozen:friendly": {
				"minecraft:interact": {
					"interactions": [
						{
							"on_interact": {
								"filters": {
									"test": "is_family",
									"subject": "other",
									"value": "player"
								},
								"event": "frozen:talked",
								"target": "self"
							},
							"interact_text": "action.interact.frozen_talk",
							"swing": true
						}
					]
				},
				"minecraft:damage_sensor": {
					"triggers": [
						{
							"on_damage": {
								"filters": {
									"test": "is_family",
									"subject": "other",
									"value": "player"
								}
							},
							"deals_damage": "no"
						}
					]
				}
			},
			"frozen:hostile": {
				"minecraft:boss": {
					"hud_range": 30,
