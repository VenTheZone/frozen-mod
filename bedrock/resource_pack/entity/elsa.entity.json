{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "frozen:elsa",
			"materials": { "default": "entity_alphatest" },
			"textures": { "default": "textures/entity/elsa" },
			"geometry": { "default": "geometry.humanoid.custom" },
			"animations": {
				"base_pose": "animation.humanoid.base_pose",
				"look_at_target": "animation.humanoid.look_at_target.default",
				"move": "animation.humanoid.move",
				"bob": "animation.humanoid.bob"
			},
			"scripts": {
				"pre_animation": [
					"variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
				],
				"animate": ["base_pose", "look_at_target", "move", "bob"]
			},
			"render_controllers": ["controller.render.default"],
			"spawn_egg": { "base_color": "#b4dcf5", "overlay_color": "#f0ebc8" }
		}
	}
}
